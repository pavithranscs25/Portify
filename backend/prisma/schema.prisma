generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(uuid()) @db.Uuid
  name         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(254)
  passwordHash String      @db.VarChar(100)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  portfolios   Portfolio[]
}

model Portfolio {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @db.Uuid
  title       String       @db.VarChar(100)
  template    String       @default("modern") @db.VarChar(20)
  slug        String?      @unique @db.VarChar(140)
  isPublished Boolean      @default(false)
  name        String       @default("") @db.VarChar(100)
  role        String       @default("") @db.VarChar(120)
  email       String       @default("") @db.VarChar(254)
  location    String       @default("") @db.VarChar(160)
  about       String       @default("") @db.Text
  photo       String?      @db.Text
  github      String       @default("") @db.VarChar(2048)
  linkedin    String       @default("") @db.VarChar(2048)
  website     String       @default("") @db.VarChar(2048)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  education   Education[]
  projects    Project[]
  experience  Experience[]
  skills      Skill[]

  @@index([userId, updatedAt])
}

model Education {
  id         String    @id @default(uuid()) @db.Uuid
  portfolioId String   @db.Uuid
  degree     String    @default("") @db.VarChar(160)
  college    String    @default("") @db.VarChar(200)
  year       String    @default("") @db.VarChar(60)
  sortOrder  Int       @default(0)
  portfolio  Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder])
}

model Project {
  id           String    @id @default(uuid()) @db.Uuid
  portfolioId  String    @db.Uuid
  name         String    @default("") @db.VarChar(160)
  description  String    @default("") @db.Text
  technologies String    @default("") @db.Text
  link         String    @default("") @db.VarChar(2048)
  sortOrder    Int       @default(0)
  portfolio    Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder])
}

model Experience {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  role        String    @default("") @db.VarChar(160)
  company     String    @default("") @db.VarChar(200)
  period      String    @default("") @db.VarChar(100)
  description String    @default("") @db.Text
  sortOrder   Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@index([portfolioId, sortOrder])
}

model Skill {
  id          String    @id @default(uuid()) @db.Uuid
  portfolioId String    @db.Uuid
  name        String    @db.VarChar(80)
  sortOrder   Int       @default(0)
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, name])
  @@index([portfolioId, sortOrder])
}
